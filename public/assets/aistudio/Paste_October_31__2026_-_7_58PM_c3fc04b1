      function syncReadoutUI() {
        document.getElementById('readout-ammeter').textContent = Math.abs(appState.ammeterReadingA).toFixed(2) + ' A';
        document.getElementById('readout-voltmeter').textContent = Math.abs(appState.voltmeterReadingV).toFixed(2) + ' V';
