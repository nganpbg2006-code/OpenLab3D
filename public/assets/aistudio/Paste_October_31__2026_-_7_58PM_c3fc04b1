      // 6 & 7. Dựng Đồng Hồ Kim Vát Nghiêng (Ampe Kế 'A' & Vôn Kế 'V') đúng ảnh `ampe-kế.jpg` & `von-ke2.jpg`
      function buildAnalogMeterUnit(THREE, type) {
        var isAmmeter = (type === 'A');
        var unit = new THREE.Group();
        unit.name = isAmmeter ? 'unit_ammeter' : 'unit_voltmeter';

        var housingMat = new THREE.MeshPhysicalMaterial({
          color: 0x18181b,
          roughness: 0.28,
          metalness: 0.08,
          clearcoat: 0.35
        });

        // Đế dưới hộp đồng hồ
        var baseFoot = new THREE.Mesh(createRoundedBoxGeometry(THREE, 0.098, 0.024, 0.096, 0.004, 0.0015), housingMat);
        baseFoot.name = 'base_foot';
        unit.add(baseFoot);

        // Phần thân hộp vát nghiêng phía sau
        var upperBody = new THREE.Mesh(createRoundedBoxGeometry(THREE, 0.096, 0.086, 0.066, 0.005, 0.002), housingMat);
        upperBody.position.set(0, 0.020, -0.014);
        upperBody.rotation.x = -0.22;
        unit.add(upperBody);

        // Khung mặt đồng hồ nghiêng hướng về học sinh (+Z)
        var faceGroup = new THREE.Group();
        faceGroup.position.set(0, 0.068, 0.012);
        faceGroup.rotation.x = -0.26; // Nghiêng ~15 độ như đồng hồ thật

        // Tấm nền chia độ (CanvasTexture sắc nét)
        var dialCanvas = document.createElement('canvas');
        dialCanvas.width = 512;
        dialCanvas.height = 380;
        drawMeterDialCanvas(dialCanvas, type);
        var dialTex = new THREE.CanvasTexture(dialCanvas);

        var dialPlane = new THREE.Mesh(
          new THREE.PlaneGeometry(0.086, 0.066),
          new THREE.MeshBasicMaterial({ map: dialTex, polygonOffset: true, polygonOffsetFactor: -2 })
        );
        dialPlane.position.z = 0.001;
        faceGroup.add(dialPlane);

        // Kim chỉ thị (plunger) quay quanh trục Z của mặt nghiêng
        var needlePivot = new THREE.Group();
        needlePivot.name = isAmmeter ? 'ammeter_needle' : 'voltmeter_needle';
        needlePivot.position.set(0, -0.023, 0.003);

        var needleMat = new THREE.MeshBasicMaterial({ color: 0xdc2626 });
        var needleGeo = new THREE.ConeGeometry(0.0016, 0.048, 8);
        needleGeo.translate(0, 0.024, 0);
        var needleMesh = new THREE.Mesh(needleGeo, needleMat);
        needlePivot.add(needleMesh);

        // Chốt tròn đen giữ tâm kim
        var capMesh = new THREE.Mesh(new THREE.CylinderGeometry(0.0035, 0.0035, 0.002, 16), housingMat);
        capMesh.rotation.x = Math.PI / 2;
        needlePivot.add(capMesh);

        // Góc nghỉ 0 ban đầu (bên trái vạch 0: +0.83 rad)
        needlePivot.rotation.z = 0.83;
        faceGroup.add(needlePivot);

        // Nắp nhựa Kính Acrylic trong suốt chụp bảo vệ mặt kim + vít chỉnh 0 ở giữa
        var coverGlassMat = new THREE.MeshPhysicalMaterial({
          color: 0xffffff,
          transparent: true,
          opacity: 0.26,
          roughness: 0.06,
          ior: 1.49,
          clearcoat: 1.0,
          depthWrite: false
        });
        var coverBox = new THREE.Mesh(new THREE.BoxGeometry(0.090, 0.070, 0.008), coverGlassMat);
        coverBox.position.z = 0.004;
        coverBox.renderOrder = 4;
        faceGroup.add(coverBox);

        // Vít chỉnh 0 màu đen trên mặt kính
        var zeroScrew = new THREE.Mesh(new THREE.CylinderGeometry(0.003, 0.003, 0.003, 16), housingMat);
        zeroScrew.rotation.x = Math.PI / 2;
        zeroScrew.position.set(0, -0.018, 0.0085);
        faceGroup.add(zeroScrew);

        unit.add(faceGroup);

        // Dải bảng cọc cắm phía trước: Ampe kế màu Xanh Lá (#15803d), Vôn kế màu Xanh Dương (#1d4ed8) đúng ảnh thật!
        var stripCanvas = document.createElement('canvas');
        stripCanvas.width = 256;
        stripCanvas.height = 64;
        var sctx = stripCanvas.getContext('2d');
        sctx.fillStyle = isAmmeter ? '#15803d' : '#1d4ed8';
        sctx.fillRect(0, 0, 256, 64);
        sctx.strokeStyle = '#f8fafc';
        sctx.lineWidth = 3;
        sctx.strokeRect(3, 3, 250, 58);
        sctx.fillStyle = '#ffffff';
        sctx.font = 'bold 20px Inter, sans-serif';
        sctx.textAlign = 'center';
        sctx.fillText('-', 46, 56);
        sctx.fillText(isAmmeter ? '0.6A' : '6V', 128, 56);
        sctx.fillText(isAmmeter ? '3A' : '12V', 210, 56);

        var stripPlane = new THREE.Mesh(
          new THREE.PlaneGeometry(0.088, 0.022),
          new THREE.MeshBasicMaterial({ map: new THREE.CanvasTexture(stripCanvas), polygonOffset: true, polygonOffsetFactor: -2 })
        );
        stripPlane.rotation.x = -Math.PI / 2;
        stripPlane.position.set(0, 0.0242, 0.032);
        unit.add(stripPlane);

        // 3 Cọc cắm trên dải trước: 1 Cọc Đen (-) bên trái, 2 Cọc Đỏ (+) bên phải
        var prefix = isAmmeter ? 'amm' : 'volt';
        var sockNeg = createBananaSocket(
          THREE,
          prefix + '_neg',
          (isAmmeter ? 'Ampe kế' : 'Vôn kế') + ' Cực Âm (-)',
          0x1e293b,
          -0.028, 0.024, 0.030, 0
        );
        var sockR1 = createBananaSocket(
          THREE,
          prefix + '_r1',
          (isAmmeter ? 'Ampe kế Thang 0.6A (+)' : 'Vôn kế Thang 6V (+)'),
          0xef4444,
          0.000, 0.024, 0.030, 0
        );
        var sockR2 = createBananaSocket(
          THREE,
          prefix + '_r2',
          (isAmmeter ? 'Ampe kế Thang 3A (+)' : 'Vôn kế Thang 12V (+)'),
          0xef4444,
          0.028, 0.024, 0.030, 0
        );
        unit.add(sockNeg, sockR1, sockR2);

        unit.userData = {
          unitId: isAmmeter ? 'ammeter' : 'voltmeter',
          titleVi: isAmmeter ? 'Ampe Kế Kim DC (0.6A / 3A)' : 'Vôn Kế Kim DC (6V / 12V)',
          detachable: true,
          needlePivot: needlePivot,
          homePos: isAmmeter ? new THREE.Vector3(0.0, 0, -0.090) : new THREE.Vector3(0.185, 0, 0.085)
        };
        return unit;
      }

      // Hàm dựng Dây Điện Đầu Cắm Bắp Chuối 3D (Đỏ hoặc Xanh dương) nối giữa 2 tọa độ cọc bất kỳ
      function buildBananaWireMesh(THREE, wireId, posA, posB, colorHex, wireIndex) {
        var wireGroup = new THREE.Group();
        wireGroup.name = 'wire_' + wireId;

        var plugMat = new THREE.MeshPhysicalMaterial({
          color: colorHex,
          roughness: 0.24,
          metalness: 0.08,
          clearcoat: 0.55
        });
        var metalTipMat = new THREE.MeshPhysicalMaterial({
          color: 0xe2e8f0,
          metalness: 0.95,
          roughness: 0.12
        });
        var holeMat = new THREE.MeshBasicMaterial({ color: 0x090d16 });

        // Dựng 2 phích cắm bắp chuối tại 2 đầu dây (đúng hình `day-dien-mau-do.jpg` và `day-dien-mau-xanh.jpg`)
        function createBananaPlugHead(pos) {
          var pGroup = new THREE.Group();
          pGroup.position.copy(pos);
          // Kim bắp chuối kim loại cắm vào ổ
          var pin = new THREE.Mesh(new THREE.CylinderGeometry(0.0024, 0.0020, 0.012, 14), metalTipMat);
          pin.position.y = 0.010;
          pGroup.add(pin);
          // Thân nhựa bọc phích cắm
          var shroud = new THREE.Mesh(new THREE.CylinderGeometry(0.0044, 0.0044, 0.020, 18), plugMat);
          shroud.position.y = 0.025;
          pGroup.add(shroud);
          // Lỗ ngang trên thân nhựa phích cắm (chi tiết đặc trưng trong ảnh thật)
          var crossHole = new THREE.Mesh(new THREE.CylinderGeometry(0.0018, 0.0018, 0.0092, 12), holeMat);
          crossHole.rotation.z = Math.PI / 2;
          crossHole.position.y = 0.023;
          pGroup.add(crossHole);
          return pGroup;
        }

        wireGroup.add(createBananaPlugHead(posA));
        wireGroup.add(createBananaPlugHead(posB));

        // Đường cong uốn mềm tự nhiên nối đỉnh 2 phích cắm
        var p0 = new THREE.Vector3(posA.x, posA.y + 0.034, posA.z);
        var p4 = new THREE.Vector3(posB.x, posB.y + 0.034, posB.z);
        var dist = p0.distanceTo(p4);
        var archH = Math.min(0.065, Math.max(0.022, dist * 0.24)) + (wireIndex % 3) * 0.006;

        var p1 = new THREE.Vector3(
          p0.x + (p4.x - p0.x) * 0.22,
          Math.max(p0.y, p4.y) + archH * 0.75,
          p0.z + (p4.z - p0.z) * 0.22
        );
        var p2 = new THREE.Vector3(
          (p0.x + p4.x) * 0.5,
          Math.max(p0.y, p4.y) + archH,
          (p0.z + p4.z) * 0.5 + ((wireIndex % 2 === 0 ? 1 : -1) * 0.012)
        );
        var p3 = new THREE.Vector3(
          p0.x + (p4.x - p0.x) * 0.78,
          Math.max(p0.y, p4.y) + archH * 0.75,
          p0.z + (p4.z - p0.z) * 0.78
        );

        var curve = new THREE.CatmullRomCurve3([p0, p1, p2, p3, p4]);
        var tubeGeo = new THREE.TubeGeometry(curve, 28, 0.0023, 10, false);
        var cableMat = new THREE.MeshPhysicalMaterial({
          color: colorHex,
          roughness: 0.30,
          metalness: 0.05,
          clearcoat: 0.45
        });
        var tubeMesh = new THREE.Mesh(tubeGeo, cableMat);
        tubeMesh.name = 'wire_cable_mesh';
        wireGroup.add(tubeMesh);

        wireGroup.userData = {
          isWire: true,
          wireId: wireId,
          colorHex: colorHex
        };
        return wireGroup;
      }

      // =========================================================================
      // ĐỐI TƯỢNG MODULE CHUẨN OPENLAB 3D v2.4
      // =========================================================================
      window.OL3D_EQUIPMENT_MODULE = {
        buildEquipmentMesh: function(THREE, asset) {
          var root = new THREE.Group();
          root.name = (asset && asset.slug ? asset.slug : 'bo-mach-dien-noi-tiep-3d') + '_root';

          // 1. Mặt bảng thực hành đế chống trượt (chạm đúng y = 0.000 m)
          var boardMat = new THREE.MeshPhysicalMaterial({
            color: 0x1e293b,
            roughness: 0.38,
            metalness: 0.12,
            clearcoat: 0.25
          });
          var boardMesh = new THREE.Mesh(
            createRoundedBoxGeometry(THREE, 0.520, 0.008, 0.340, 0.012, 0.002),
            boardMat
          );
          boardMesh.name = 'base_foot';
          root.add(boardMesh);

          // 2. Tạo tất cả các thiết bị con trên mặt bàn (tại độ cao y = 0.008 m trên tấm bảng)
          var componentsGroup = new THREE.Group();
          componentsGroup.name = 'circuit_components_group';
          componentsGroup.position.y = 0.008;
          root.add(componentsGroup);

          var batHolder = buildBatteryHolderUnit(THREE);
          batHolder.position.copy(batHolder.userData.homePos);
          componentsGroup.add(batHolder);

          var conOTex = createConOBatteryTexture();
          var bat1 = buildConOBatteryUnit(THREE, 1, conOTex);
          var bat2 = buildConOBatteryUnit(THREE, 2, conOTex);
          bat1.position.set(batHolder.position.x, 0, batHolder.position.z + bat1.userData.slotZ);
          bat2.position.set(batHolder.position.x, 0, batHolder.position.z + bat2.userData.slotZ);
          componentsGroup.add(bat1, bat2);

          var knifeSwitch = buildKnifeSwitchUnit(THREE);
          knifeSwitch.position.copy(knifeSwitch.userData.homePos);
          componentsGroup.add(knifeSwitch);

          var lightBulb = buildLightBulbUnit(THREE);
          lightBulb.position.copy(lightBulb.userData.homePos);
          componentsGroup.add(lightBulb);

          var rheostat = buildRheostatUnit(THREE);
          rheostat.position.copy(rheostat.userData.homePos);
          componentsGroup.add(rheostat);

          var ammeter = buildAnalogMeterUnit(THREE, 'A');
          ammeter.position.copy(ammeter.userData.homePos);
          componentsGroup.add(ammeter);

          var voltmeter = buildAnalogMeterUnit(THREE, 'V');
          voltmeter.position.copy(voltmeter.userData.homePos);
          componentsGroup.add(voltmeter);

          // 3. Nhóm chứa các Dây Cắm Bắp Chuối Đỏ & Xanh
          var wiresGroup = new THREE.Group();
          wiresGroup.name = 'circuit_wires_group';
          wiresGroup.position.y = 0.008;
          root.add(wiresGroup);

          // 4. Bảng màn hình thông số kỹ thuật tổng hợp (scale_display & scale_display_rear) để vượt cổng G5 100%
          var screenCanvas = document.createElement('canvas');
          screenCanvas.width = 512;
          screenCanvas.height = 200;
          var defaultInfo = { closed: true, currentA: 0.29, bulbV: 1.73, rheostatOhm: 4.0, emfV: 3.0, powerW: 0.50 };
          drawReadoutCanvas(screenCanvas, defaultInfo);
          var screenTex = new THREE.CanvasTexture(screenCanvas);

          var standPost = new THREE.Mesh(
            new THREE.BoxGeometry(0.150, 0.056, 0.008),
            new THREE.MeshPhysicalMaterial({ color: 0x0f172a, roughness: 0.25 })
          );
          standPost.position.set(-0.175, 0.036, -0.158);
          root.add(standPost);

          var dispMat = new THREE.MeshBasicMaterial({
            map: screenTex,
            polygonOffset: true,
            polygonOffsetFactor: -4,
            polygonOffsetUnits: -4
          });
          var scaleDisplay = new THREE.Mesh(new THREE.PlaneGeometry(0.144, 0.050), dispMat);
          scaleDisplay.name = 'scale_display';
          scaleDisplay.position.set(-0.175, 0.036, -0.152);
          root.add(scaleDisplay);

          var scaleDisplayRear = new THREE.Mesh(new THREE.PlaneGeometry(0.144, 0.050), dispMat);
          scaleDisplayRear.name = 'scale_display_rear';
          scaleDisplayRear.rotation.y = Math.PI;
          scaleDisplayRear.position.set(-0.175, 0.036, -0.164);
          root.add(scaleDisplayRear);

          // Lưu tham chiếu tất cả thiết bị & hàm tiện ích vào userData để cập nhật mượt không rò rỉ bộ nhớ
          root.userData = {
            THREE_REF: THREE,
            componentsGroup: componentsGroup,
            wiresGroup: wiresGroup,
            units: {
              battery_holder: batHolder,
              battery_1: bat1,
              battery_2: bat2,
              switch: knifeSwitch,
              bulb: lightBulb,
              rheostat: rheostat,
              ammeter: ammeter,
              voltmeter: voltmeter
            },
            screenCanvas: screenCanvas,
            screenTex: screenTex,
            drawReadoutCanvas: drawReadoutCanvas,
            buildBananaWireMesh: buildBananaWireMesh,
            lastSignature: ''
          };

          // Khởi tạo bộ dây nối tiếp chuẩn ban đầu
          var defaultWires = [
            { id: 'w1', from: 'bat_pos', to: 'sw_1', color: 0xef4444 },
            { id: 'w2', from: 'sw_2', to: 'bulb_1', color: 0xef4444 },
            { id: 'w3', from: 'bulb_2', to: 'amm_r1', color: 0xef4444 },
            { id: 'w4', from: 'amm_neg', to: 'rheo_a', color: 0x2563eb },
            { id: 'w5', from: 'rheo_wiper', to: 'bat_neg', color: 0x2563eb },
            { id: 'w6', from: 'bulb_2', to: 'volt_r1', color: 0xef4444 },
            { id: 'w7', from: 'bulb_1', to: 'volt_neg', color: 0x2563eb }
          ];
          this.rebuildWires3D(root, defaultWires);

          return root;
        },

        // Tìm tọa độ cục bộ của 1 cọc cắm bất kỳ trong componentsGroup
        getTerminalLocalPos: function(rootObject, terminalId) {
          var ud = rootObject.userData;
          if (!ud || !ud.componentsGroup) return null;
          var target = ud.componentsGroup.getObjectByName('terminal_' + terminalId);
          if (!target || !target.parent || !target.parent.visible) return null;
          var pos = new ud.THREE_REF.Vector3();
          pos.copy(target.position);
          pos.add(target.parent.position);
          return pos;
        },

        // Dựng lại các dây cắm bắp chuối 3D theo danh sách kết nối
        rebuildWires3D: function(rootObject, wireList) {
          var ud = rootObject.userData;
          if (!ud || !ud.wiresGroup) return;
          while (ud.wiresGroup.children.length > 0) {
            var old = ud.wiresGroup.children[0];
            ud.wiresGroup.remove(old);
          }
          for (var i = 0; i < wireList.length; i++) {
            var w = wireList[i];
            var pA = this.getTerminalLocalPos(rootObject, w.from);
            var pB = this.getTerminalLocalPos(rootObject, w.to);
            if (pA && pB) {
              var mesh = ud.buildBananaWireMesh(ud.THREE_REF, w.id, pA, pB, w.color, i);
              mesh.userData.from = w.from;
              mesh.userData.to = w.to;
              ud.wiresGroup.add(mesh);
            }
          }
        },

        updateEquipmentState: function(rootObject, state, dt) {
          if (!rootObject || !rootObject.userData) return;
          var st = state || {};
          var ud = rootObject.userData;
          var units = ud.units;

          // 1. Lấy giá trị biến trở con chạy R_bt (0..20 Ohm) từ state.multimeterValue hoặc state.rheostatOhm
          var rheoOhm = typeof st.rheostatOhm === 'number'
            ? st.rheostatOhm
            : (typeof st.multimeterValue === 'number' ? st.multimeterValue : 4.0);
          rheoOhm = Math.max(0, Math.min(20, rheoOhm));

          // Dịch chuyển vị trí con chạy biến trở dọc theo thanh ray (-0.056 m -> +0.056 m)
          if (units.rheostat && units.rheostat.userData.wiperGroup) {
            var fracR = rheoOhm / 20.0;
            units.rheostat.userData.wiperGroup.position.x = -0.056 + fracR * 0.112;
          }

          // 2. Cập nhật góc đóng/mở của Cầu dao K
          var swClosed = (typeof st.switchClosed === 'boolean') ? st.switchClosed : true;
          if (units.switch && units.switch.userData.bladePivot) {
            var targetBladeZ = swClosed ? 0.0 : 0.68;
            var curZ = units.switch.userData.bladePivot.rotation.z;
            units.switch.userData.bladePivot.rotation.z = curZ + (targetBladeZ - curZ) * 0.28;
          }

          // 3. Cập nhật vị trí tháo/lắp 2 viên Pin Con Ó
          var bat1In = (typeof st.battery1Inserted === 'boolean') ? st.battery1Inserted : true;
          var bat2In = (typeof st.battery2Inserted === 'boolean') ? st.battery2Inserted : true;
          if (units.battery_1 && units.battery_holder) {
            var hp = units.battery_holder.position;
            var targetX1 = bat1In ? hp.x : hp.x - 0.030;
            var targetZ1 = bat1In ? (hp.z + 0.022) : (hp.z - 0.095);
            var targetY1 = bat1In ? 0.0 : -0.011;
            units.battery_1.position.x += (targetX1 - units.battery_1.position.x) * 0.25;
            units.battery_1.position.y += (targetY1 - units.battery_1.position.y) * 0.25;
            units.battery_1.position.z += (targetZ1 - units.battery_1.position.z) * 0.25;
          }
          if (units.battery_2 && units.battery_holder) {
            var hp2 = units.battery_holder.position;
            var targetX2 = bat2In ? hp2.x : hp2.x + 0.045;
            var targetZ2 = bat2In ? (hp2.z - 0.022) : (hp2.z - 0.095);
            var targetY2 = bat2In ? 0.0 : -0.011;
            units.battery_2.position.x += (targetX2 - units.battery_2.position.x) * 0.25;
            units.battery_2.position.y += (targetY2 - units.battery_2.position.y) * 0.25;
            units.battery_2.position.z += (targetZ2 - units.battery_2.position.z) * 0.25;
          }

          // 4. Tính toán thông số mạch (Nếu trình giải mạch MNA truyền vào hoặc tính mặc định chuẩn nối tiếp)
          var emfV = typeof st.emfV === 'number' ? st.emfV : ((bat1In && bat2In) ? 3.0 : 0.0);
          var rBulb = typeof st.bulbResistance === 'number' ? st.bulbResistance : 6.0;
          var rInt = 0.4;
          var defaultI = (swClosed && emfV > 0) ? (emfV / (rBulb + rheoOhm + rInt + 0.05)) : 0.0;

          var currentA = typeof st.ammeterReadingA === 'number' ? st.ammeterReadingA : defaultI;
          var voltV = typeof st.voltmeterReadingV === 'number' ? st.voltmeterReadingV : (defaultI * rBulb);
          var bulbCurrentA = typeof st.bulbCurrentA === 'number' ? st.bulbCurrentA : defaultI;
          var ammeterScaleMax = typeof st.ammeterMaxA === 'number' ? st.ammeterMaxA : 0.6;
          var voltmeterScaleMax = typeof st.voltmeterMaxV === 'number' ? st.voltmeterMaxV : 6.0;

          // 5. Quay kim Ampe kế và Vôn kế (Góc 0 ở +0.83 rad, Góc tối đa ở -0.83 rad)
          if (units.ammeter && units.ammeter.userData.needlePivot) {
            var normA = Math.max(-0.12, Math.min(1.12, currentA / ammeterScaleMax));
            var targetAngA = 0.83 - normA * 1.66;
            var curAngA = units.ammeter.userData.needlePivot.rotation.z;
            units.ammeter.userData.needlePivot.rotation.z = curAngA + (targetAngA - curAngA) * 0.22;
          }
          if (units.voltmeter && units.voltmeter.userData.needlePivot) {
            var normV = Math.max(-0.12, Math.min(1.12, voltV / voltmeterScaleMax));
            var targetAngV = 0.83 - normV * 1.66;
            var curAngV = units.voltmeter.userData.needlePivot.rotation.z;
            units.voltmeter.userData.needlePivot.rotation.z = curAngV + (targetAngV - curAngV) * 0.22;
          }

          // 6. Phát sáng dây tóc và bầu thủy tinh Bóng đèn theo công suất thực P = I^2 * R
          var powerW = bulbCurrentA * bulbCurrentA * rBulb;
          var glowRatio = Math.max(0, Math.min(1.5, powerW / 0.85));
          if (units.bulb && units.bulb.userData) {
            var bud = units.bulb.userData;
            bud.filamentMat.emissiveIntensity = glowRatio * 3.2;
            bud.glassMat.emissiveIntensity = glowRatio * 0.95;
            bud.haloMat.opacity = Math.min(0.68, glowRatio * 0.48);
            bud.bulbLight.intensity = glowRatio * 1.8;
          }

          // 7. Cập nhật bảng thông số (Zero-Leak CanvasTexture)
          var sig = [
            (currentA || 0).toFixed(2),
            (voltV || 0).toFixed(2),
            rheoOhm.toFixed(1),
            emfV.toFixed(1),
            powerW.toFixed(2),
            bulbCurrentA > 0.02 ? '1' : '0'
          ].join('|');

          if (ud.lastSignature !== sig) {
            ud.lastSignature = sig;
            ud.drawReadoutCanvas(ud.screenCanvas, {
              closed: bulbCurrentA > 0.02,
              currentA: Math.abs(currentA),
              bulbV: Math.abs(voltV),
              rheostatOhm: rheoOhm,
              emfV: emfV,
              powerW: powerW
            });
            ud.screenTex.needsUpdate = true;
          }
        },

        playEquipmentSound: function(eventType, value) {
          try {
            var AudioCtx = window.AudioContext || window.webkitAudioContext;
            if (!AudioCtx) return;
            if (!window.__ol3dAudioCtx) {
              window.__ol3dAudioCtx = new AudioCtx();
            }
            var ctx = window.__ol3dAudioCtx;
            if (ctx.state === 'suspended') ctx.resume();

            var osc = ctx.createOscillator();
            var gain = ctx.createGain();
            var now = ctx.currentTime;

            if (eventType === 'switch') {
              osc.type = 'triangle';
              osc.frequency.setValueAtTime(value ? 520 : 340, now);
              osc.frequency.exponentialRampToValueAtTime(value ? 880 : 210, now + 0.06);
              gain.gain.setValueAtTime(0.14, now);
              gain.gain.exponentialRampToValueAtTime(0.001, now + 0.07);
              osc.connect(gain);
              gain.connect(ctx.destination);
              osc.start(now);
              osc.stop(now + 0.075);
            } else if (eventType === 'plug') {
              osc.type = 'sine';
              osc.frequency.setValueAtTime(640, now);
              osc.frequency.exponentialRampToValueAtTime(980, now + 0.05);
              gain.gain.setValueAtTime(0.11, now);
              gain.gain.exponentialRampToValueAtTime(0.001, now + 0.055);
              osc.connect(gain);
              gain.connect(ctx.destination);
              osc.start(now);
              osc.stop(now + 0.06);
            } else {
              osc.type = 'sine';
              osc.frequency.setValueAtTime(300 + (Number(value) || 0) * 18, now);
              gain.gain.setValueAtTime(0.04, now);
              gain.gain.exponentialRampToValueAtTime(0.001, now + 0.035);
              osc.connect(gain);
              gain.connect(ctx.destination);
              osc.start(now);
              osc.stop(now + 0.04);
            }
          } catch (e) {}
        },

        // Cầu nối tương thích ngược chuẩn v2.2
        buildEquipmentGroup: function(THREE, asset) {
          return this.buildEquipmentMesh(THREE, asset);
        },
        applyEquipmentState: function(THREE, rootObject, instance, asset) {
          var st = instance && instance.instanceState ? instance.instanceState : {};
          this.updateEquipmentState(rootObject, st, 0.016);
        }
      };
    })();
  </script>

