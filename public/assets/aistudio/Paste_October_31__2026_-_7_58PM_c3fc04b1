        var sockW = createBananaSocket(THREE, 'rheo_wiper', 'Cọc Con Chạy Biến Trở (Giữa - Xanh)', 0x2563eb, 0.0, 0.014, 0.019, 0);
        var sockB = createBananaSocket(THREE, 'rheo_b', 'Cọc Biến Trở B (Đầu Cuối - Xanh)', 0x2563eb, 0.058, 0.014, 0.019, 0);
        unit.add(sockA, sockW, sockB);

        unit.userData = {
          unitId: 'rheostat',
          titleVi: 'Biến Trở Con Chạy (0 – 20 Ω, 2A)',
