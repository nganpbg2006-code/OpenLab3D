        topRod.position.set(0, 0.061, -0.008);
        unit.add(topRod);

        // 2 núm vặn màu đỏ ở 2 đầu thanh ray trên (đúng như ảnh chụp)
        var redCapMat = new THREE.MeshPhysicalMaterial({ color: 0xdc2626, roughness: 0.25 });
        var capL = new THREE.Mesh(new THREE.CylinderGeometry(0.0055, 0.0055, 0.012, 16), redCapMat);
        capL.rotation.z = Math.PI / 2;
        capL.position.set(-0.084, 0.061, -0.008);
        unit.add(capL);

        var capR = new THREE.Mesh(new THREE.CylinderGeometry(0.0055, 0.0055, 0.012, 16), redCapMat);
        capR.rotation.z = Math.PI / 2;
        capR.position.set(0.084, 0.061, -0.008);
        unit.add(capR);

        // Con chạy biến trở (plunger) có tem "20Ω" trên đỉnh
        var wiperGroup = new THREE.Group();
        wiperGroup.name = 'plunger';
        var wiperBody = new THREE.Mesh(createRoundedBoxGeometry(THREE, 0.024, 0.022, 0.028, 0.002, 0.001), standMat);
        wiperBody.position.y = 0.052;
        wiperGroup.add(wiperBody);

        // Lá đồng tiếp xúc ôm xuống cuộn dây
        var wiperContact = new THREE.Mesh(new THREE.BoxGeometry(0.010, 0.012, 0.030), rodMat);
        wiperContact.position.y = 0.044;
        wiperGroup.add(wiperContact);

        // Tem "20Ω" màu trắng xanh trên lưng con chạy
        var tagCanvas = document.createElement('canvas');
        tagCanvas.width = 128;
        tagCanvas.height = 64;
        var tctx = tagCanvas.getContext('2d');
