        document.getElementById('badge-volt-scale').textContent = 'Thang ' + appState.voltmeterMaxV + 'V';

        var rTot = appState.bulbResistance + appState.rheostatOhm + 0.45;
        var uBulb = appState.bulbCurrentA * appState.bulbResistance;
        var pBulb = appState.bulbCurrentA * appState.bulbCurrentA * appState.bulbResistance;

        document.getElementById('readout-rtotal').textContent = rTot.toFixed(2) + ' Ω';
        document.getElementById('readout-ubulb').textContent = uBulb.toFixed(2) + ' V';
        document.getElementById('readout-pbulb').textContent = pBulb.toFixed(2) + ' W ' +
          (pBulb > 0.6 ? '(Sáng rực)' : (pBulb > 0.15 ? '(Sáng rõ)' : (pBulb > 0.02 ? '(Sáng mờ)' : '(Tắt)')));

        var dot = document.getElementById('circuit-status-dot');
        var title = document.getElementById('circuit-status-title');
        var desc = document.getElementById('circuit-status-desc');
        desc.textContent = appState.circuitMessage;

        if (appState.circuitStatus === 'CLOSED_NORMAL') {
          dot.className = 'w-3 h-3 rounded-full bg-emerald-400 shadow-[0_0_12px_#4ade80]';
          title.className = 'text-xs font-bold text-emerald-300';
          title.textContent = 'MẠCH ĐIỆN NỐI TIẾP KÍN — BÓNG ĐÈN ĐANG SÁNG';
