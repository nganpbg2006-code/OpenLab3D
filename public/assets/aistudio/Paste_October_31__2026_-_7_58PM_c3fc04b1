          dot.className = 'w-3 h-3 rounded-full bg-rose-500 animate-ping';
          title.className = 'text-xs font-bold text-rose-400';
          title.textContent = 'CẢNH BÁO ĐẤU DÂY — KIỂM TRA LẠI CỰC ĐỒNG HỒ!';
