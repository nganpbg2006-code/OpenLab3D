        var standL = new THREE.Mesh(createRoundedBoxGeometry(THREE, 0.014, 0.056, 0.042, 0.002, 0.001), standMat);
        standL.position.set(-0.072, 0.014, -0.008);
        unit.add(standL);

        var standR = new THREE.Mesh(createRoundedBoxGeometry(THREE, 0.014, 0.056, 0.042, 0.002, 0.001), standMat);
        standR.position.set(0.072, 0.014, -0.008);
        unit.add(standR);

        // Ống sứ quấn dây hợp kim Nikelin màu xám đen có vân vòng dây sát nhau
        var coilCanvas = document.createElement('canvas');
        coilCanvas.width = 512;
        coilCanvas.height = 64;
        var cctx = coilCanvas.getContext('2d');
        for (var i = 0; i < 512; i += 4) {
