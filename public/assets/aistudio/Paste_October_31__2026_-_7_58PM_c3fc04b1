          dot.className = 'w-3 h-3 rounded-full bg-amber-400';
          title.className = 'text-xs font-bold text-amber-300';
          title.textContent = 'MẠCH ĐANG HỞ — CHƯA CÓ DÒNG ĐIỆN QUA ĐÈN';
        }
      }

