  <!-- ============================================================================
       SCRIPT TRẠM THỰC HÀNH ĐỘC LẬP, BỘ GIẢI MẠCH ĐIỆN MNA & TƯƠNG TÁC 3D
       ============================================================================ -->
  <script>
    (function() {
      // Đọc manifest
      var manifestEl = document.getElementById('ol3d-module-manifest');
      var manifest = JSON.parse(manifestEl.textContent);

      // Danh mục toàn bộ Cọc Cắm (Terminals) trên các thiết bị
      var TERMINAL_META = {
        bat_pos:     { unit: 'battery_holder', name: 'Nguồn Pin: Cực Dương (+ Đỏ)', color: '#ef4444' },
        bat_neg:     { unit: 'battery_holder', name: 'Nguồn Pin: Cực Âm (- Đen)', color: '#94a3b8' },
        bat_mid1:    { unit: 'battery_holder', name: 'Nguồn Pin: Cọc Phụ 1.5V (+)', color: '#ef4444' },
        bat_mid2:    { unit: 'battery_holder', name: 'Nguồn Pin: Cọc Phụ 1.5V (-)', color: '#94a3b8' },
        sw_1:        { unit: 'switch',         name: 'Cầu Dao K: Cọc 1 (Đỏ)', color: '#ef4444' },
        sw_2:        { unit: 'switch',         name: 'Cầu Dao K: Cọc 2 (Xanh lá)', color: '#22c55e' },
        bulb_1:      { unit: 'bulb',           name: 'Bóng Đèn 126: Cọc Âm (- Đen)', color: '#94a3b8' },
        bulb_2:      { unit: 'bulb',           name: 'Bóng Đèn 126: Cọc Dương (+ Đỏ)', color: '#ef4444' },
        rheo_a:      { unit: 'rheostat',       name: 'Biến Trở: Cọc Đầu Vào A (Cam)', color: '#f97316' },
        rheo_wiper:  { unit: 'rheostat',       name: 'Biến Trở: Cọc Con Chạy C (Giữa)', color: '#3b82f6' },
        rheo_b:      { unit: 'rheostat',       name: 'Biến Trở: Cọc Đầu Cuối B (Phải)', color: '#3b82f6' },
        amm_neg:     { unit: 'ammeter',        name: 'Ampe Kế: Cọc Âm (- Đen)', color: '#94a3b8' },
        amm_r1:      { unit: 'ammeter',        name: 'Ampe Kế: Thang 0.6A (+ Đỏ)', color: '#ef4444' },
        amm_r2:      { unit: 'ammeter',        name: 'Ampe Kế: Thang 3.0A (+ Đỏ)', color: '#ef4444' },
        volt_neg:    { unit: 'voltmeter',      name: 'Vôn Kế: Cọc Âm (- Đen)', color: '#94a3b8' },
        volt_r1:     { unit: 'voltmeter',      name: 'Vôn Kế: Thang 6V (+ Đỏ)', color: '#ef4444' },
        volt_r2:     { unit: 'voltmeter',      name: 'Vôn Kế: Thang 12V (+ Đỏ)', color: '#ef4444' }
      };

      // Trạng thái toàn bộ Bộ Thí Nghiệm
      var appState = {
        interactionMode: 'wire', // 'wire' | 'move'
        newWireColor: 0xef4444,
        selectedTerminalId: null,
        switchClosed: true,
        battery1Inserted: true,
        battery2Inserted: true,
        rheostatOhm: 4.0,
        ratedEmfV: 3.0,
        bulbResistance: 6.0,
        // Trạng thái gắn trên bàn hay đã tháo rời của từng thiết bị
        unitAttached: {
          battery_holder: true,
          battery_1: true,
          battery_2: true,
          switch: true,
          bulb: true,
          rheostat: true,
          ammeter: true,
          voltmeter: true
        },
        // Danh sách dây cắm hiện tại
        wires: [
          { id: 'w1', from: 'bat_pos',    to: 'sw_1',       color: 0xef4444 },
          { id: 'w2', from: 'sw_2',       to: 'bulb_1',     color: 0xef4444 },
          { id: 'w3', from: 'bulb_2',     to: 'amm_r1',     color: 0xef4444 },
          { id: 'w4', from: 'amm_neg',    to: 'rheo_a',     color: 0x2563eb },
          { id: 'w5', from: 'rheo_wiper', to: 'bat_neg',    color: 0x2563eb },
          { id: 'w6', from: 'bulb_2',     to: 'volt_r1',    color: 0xef4444 },
          { id: 'w7', from: 'bulb_1',     to: 'volt_neg',   color: 0x2563eb }
        ],
        // Kết quả giải mạch điện
        ammeterReadingA: 0.29,
        voltmeterReadingV: 1.73,
        bulbCurrentA: 0.29,
        ammeterMaxA: 0.6,
        voltmeterMaxV: 6.0,
        emfV: 3.0,
        totalLoopR: 10.45,
        circuitStatus: 'CLOSED_NORMAL',
        circuitMessage: 'Mạch nối tiếp hoạt động chuẩn: Dòng điện chạy từ (+) Nguồn → Cầu dao K → Bóng đèn → Ampe kế → Biến trở → (-) Nguồn.'
      };

      // =========================================================================
      // BỘ GIẢI MẠCH ĐIỆN NÚT THẬT (MODIFIED NODAL ANALYSIS / GAUSS-JORDAN)
      // Tính toán chính xác điện thế tại mọi cọc dựa trên cách cắm dây thực tế!
      // =========================================================================
      function solveElectricalCircuit() {
        var termIds = Object.keys(TERMINAL_META);
        var N = termIds.length;
        var idxMap = {};
        for (var i = 0; i < N; i++) idxMap[termIds[i]] = i;

        // Ma trận độ dẫn G (N x N) và vector dòng J (N)
        var G = [];
        var J = [];
        for (var r = 0; r < N; r++) {
          var row = [];
          for (var c = 0; c < N; c++) row.push(0);
          G.push(row);
          J.push(0);
        }

        function addResistor(tA, tB, resistanceOhm) {
          var uA = TERMINAL_META[tA].unit;
          var uB = TERMINAL_META[tB].unit;
          if (!appState.unitAttached[uA] || !appState.unitAttached[uB]) return;
          var g = 1.0 / Math.max(0.0005, resistanceOhm);
          var iA = idxMap[tA];
          var iB = idxMap[tB];
          G[iA][iA] += g;
          G[iB][iB] += g;
          G[iA][iB] -= g;
          G[iB][iA] -= g;
        }

        // 1. Thêm toàn bộ Dây Cắm Bắp Chuối (R_dây = 0.002 Ohm)
        for (var w = 0; w < appState.wires.length; w++) {
          var wire = appState.wires[w];
          addResistor(wire.from, wire.to, 0.002);
        }

        // 2. Nguồn điện (Giá đỡ pin + 2 Pin Con Ó)
        var activeCells = 0;
        if (appState.unitAttached.battery_holder) {
          if (appState.unitAttached.battery_1 && appState.battery1Inserted) activeCells++;
          if (appState.unitAttached.battery_2 && appState.battery2Inserted) activeCells++;
        }
        var actualEmf = (activeCells === 2) ? appState.ratedEmfV : (activeCells === 1 ? appState.ratedEmfV * 0.5 : 0.0);
        appState.emfV = actualEmf;

        if (appState.unitAttached.battery_holder && actualEmf > 0) {
          // Nguồn Norton tương đương giữa bat_pos và bat_neg với điện trở trong r = 0.4 Ohm
          var rInternal = 0.4;
          var gBat = 1.0 / rInternal;
          var iPos = idxMap['bat_pos'];
          var iNeg = idxMap['bat_neg'];
          G[iPos][iPos] += gBat;
          G[iNeg][iNeg] += gBat;
          G[iPos][iNeg] -= gBat;
          G[iNeg][iPos] -= gBat;
          J[iPos] += actualEmf * gBat;
          J[iNeg] -= actualEmf * gBat;

          // Cọc phụ trung gian 1.5V
          addResistor('bat_mid1', 'bat_pos', 0.2);
          addResistor('bat_mid2', 'bat_neg', 0.2);
        }

        // 3. Cầu dao K (Đóng: R = 0.01 Ohm; Mở: R = 1e8 Ohm)
        if (appState.unitAttached.switch && appState.switchClosed) {
          addResistor('sw_1', 'sw_2', 0.01);
        }

        // 4. Bóng đèn dây tóc 126 (R_đèn = 6.0 Ohm)
        if (appState.unitAttached.bulb) {
          addResistor('bulb_1', 'bulb_2', appState.bulbResistance);
        }

        // 5. Biến trở con chạy 20 Ohm (chia thành 2 nửa: A -> Wiper = R_bt, Wiper -> B = 20 - R_bt)
        if (appState.unitAttached.rheostat) {
          var rAW = Math.max(0.02, appState.rheostatOhm);
          var rWB = Math.max(0.02, 20.0 - appState.rheostatOhm);
          addResistor('rheo_a', 'rheo_wiper', rAW);
          addResistor('rheo_wiper', 'rheo_b', rWB);
        }

        // 6. Ampe kế (Điện trở shunt rất nhỏ R_A = 0.05 Ohm)
        if (appState.unitAttached.ammeter) {
          addResistor('amm_r1', 'amm_neg', 0.05);
          addResistor('amm_r2', 'amm_neg', 0.05);
        }

        // 7. Vôn kế (Điện trở trong rất lớn R_V = 10,000 Ohm)
        if (appState.unitAttached.voltmeter) {
          addResistor('volt_r1', 'volt_neg', 10000.0);
          addResistor('volt_r2', 'volt_neg', 10000.0);
        }

        // Rò đất cực nhỏ (1e-9 S) ở mọi nút để hệ phương trình luôn khả nghịch kể cả khi linh kiện tháo rời cô lập
        var iRef = idxMap['bat_neg'];
        G[iRef][iRef] += 1e6; // Cố định V(bat_neg) ~ 0V làm mốc
        for (var k = 0; k < N; k++) {
          G[k][k] += 1e-9;
        }

        // Giải hệ phương trình tuyến tính G * V = J bằng khử Gauss có chọn phần tử trụ
        var V = gaussianElimination(G, J, N);

        // Đọc dòng điện qua Bóng đèn
        var vBulb1 = V[idxMap['bulb_1']] || 0;
        var vBulb2 = V[idxMap['bulb_2']] || 0;
        var iBulb = appState.unitAttached.bulb ? Math.abs(vBulb2 - vBulb1) / appState.bulbResistance : 0;
        appState.bulbCurrentA = iBulb;

        // Đọc dòng điện qua Ampe kế và xác định thang đo đang dùng (0.6A hay 3A)
        var iAmm1 = (V[idxMap['amm_r1']] - V[idxMap['amm_neg']]) / 0.05;
        var iAmm2 = (V[idxMap['amm_r2']] - V[idxMap['amm_neg']]) / 0.05;
        var usedR2Amm = Math.abs(iAmm2) > Math.abs(iAmm1) && Math.abs(iAmm2) > 0.001;
        appState.ammeterMaxA = usedR2Amm ? 3.0 : 0.6;
        appState.ammeterReadingA = appState.unitAttached.ammeter ? (iAmm1 + iAmm2) : 0;

        // Đọc hiệu điện thế trên Vôn kế và xác định thang đo (6V hay 12V)
        var uVolt1 = V[idxMap['volt_r1']] - V[idxMap['volt_neg']];
        var uVolt2 = V[idxMap['volt_r2']] - V[idxMap['volt_neg']];
        var usedR2Volt = Math.abs(uVolt2) > Math.abs(uVolt1) && Math.abs(uVolt2) > 0.01;
        appState.voltmeterMaxV = usedR2Volt ? 12.0 : 6.0;
        appState.voltmeterReadingV = appState.unitAttached.voltmeter ? (usedR2Volt ? uVolt2 : uVolt1) : 0;

        // Phân tích trạng thái mạch để hiển thị phản hồi sư phạm rõ ràng
        if (actualEmf <= 0.01) {
          appState.circuitStatus = 'NO_BATTERY';
          appState.circuitMessage = 'Chưa lắp đủ Pin Con Ó vào giá đỡ hoặc nguồn đã tháo rời (E = 0 V).';
        } else if (!appState.switchClosed && iBulb < 0.01) {
          appState.circuitStatus = 'OPEN_SWITCH';
          appState.circuitMessage = 'Cầu dao K đang NGẮT (Mạch hở) — Dòng điện I = 0 A, bóng đèn tắt.';
        } else if (Math.abs(appState.ammeterReadingA) > 2.8 && iBulb < 0.05) {
          appState.circuitStatus = 'SHORT_CIRCUIT';
          appState.circuitMessage = 'CẢNH BÁO ĐOẢN MẠCH! Ampe kế đang mắc trực tiếp vào hai cực nguồn không qua bóng đèn!';
        } else if (appState.ammeterReadingA < -0.01 || appState.voltmeterReadingV < -0.05) {
          appState.circuitStatus = 'REVERSE_POLARITY';
          appState.circuitMessage = 'LƯU Ý: Cắm ngược cực (+) và (-) trên Ampe kế hoặc Vôn kế khiến kim bị lệch ngược về bên trái vạch 0!';
        } else if (iBulb > 0.02) {
          appState.circuitStatus = 'CLOSED_NORMAL';
          appState.circuitMessage = 'Mạch điện kín hoạt động tốt! I = ' + Math.abs(appState.ammeterReadingA).toFixed(2) + ' A, U_đèn = ' + (iBulb * appState.bulbResistance).toFixed(2) + ' V.';
        } else {
          appState.circuitStatus = 'OPEN_WIRE';
          appState.circuitMessage = 'Mạch đang hở (chưa nối kín vòng dây từ (+) Nguồn qua Bóng đèn về (-) Nguồn hoặc Vôn kế đang mắc nối tiếp).';
        }
      }

      function gaussianElimination(A, b, n) {
        var M = [];
        for (var i = 0; i < n; i++) {
          var row = A[i].slice();
          row.push(b[i]);
          M.push(row);
        }
        for (var k = 0; k < n; k++) {
          var iMax = k;
          var vMax = Math.abs(M[k][k]);
          for (var i = k + 1; i < n; i++) {
            if (Math.abs(M[i][k]) > vMax) {
              vMax = Math.abs(M[i][k]);
              iMax = i;
            }
          }
          if (iMax !== k) {
            var temp = M[k];
            M[k] = M[iMax];
            M[iMax] = temp;
          }
          var pivot = M[k][k];
          if (Math.abs(pivot) < 1e-12) continue;
          for (var i = k + 1; i < n; i++) {
            var f = M[i][k] / pivot;
            for (var j = k; j <= n; j++) {
              M[i][j] -= M[k][j] * f;
            }
          }
        }
        var x = new Array(n).fill(0);
        for (var i = n - 1; i >= 0; i--) {
          var sum = M[i][n];
          for (var j = i + 1; j < n; j++) {
            sum -= M[i][j] * x[j];
          }
          x[i] = Math.abs(M[i][i]) > 1e-12 ? (sum / M[i][i]) : 0;
        }
        return x;
      }

      // =========================================================================
      // KHỞI TẠO KHÔNG GIAN 3D THREE.JS (STUDIO LIGHTING + ORBIT/PAN + RAYCASTER)
      // =========================================================================
      var container = document.getElementById('canvas-container');
      var scene = new THREE.Scene();

      var camera = new THREE.PerspectiveCamera(42, container.clientWidth / container.clientHeight, 0.01, 20);
      var camSpherical = { radius: 0.68, phi: 0.92, theta: 0.0 };
      var camTarget = new THREE.Vector3(0, 0.035, 0.01);

      function updateCameraFromSpherical() {
        camSpherical.phi = Math.max(0.18, Math.min(1.48, camSpherical.phi));
        camSpherical.radius = Math.max(0.24, Math.min(1.45, camSpherical.radius));
        camera.position.x = camTarget.x + camSpherical.radius * Math.sin(camSpherical.phi) * Math.sin(camSpherical.theta);
        camera.position.y = camTarget.y + camSpherical.radius * Math.cos(camSpherical.phi);
        camera.position.z = camTarget.z + camSpherical.radius * Math.sin(camSpherical.phi) * Math.cos(camSpherical.theta);
        camera.lookAt(camTarget);
      }
      updateCameraFromSpherical();

      var renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: 'high-performance' });
      renderer.setSize(container.clientWidth, container.clientHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.12;
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;
      container.appendChild(renderer.domElement);

      // Ánh sáng phòng thí nghiệm chuẩn PBR
      var hemiLight = new THREE.HemisphereLight(0xf8fafc, 0x1e293b, 0.95);
      scene.add(hemiLight);

      var dirLight = new THREE.DirectionalLight(0xffffff, 1.35);
      dirLight.position.set(0.45, 0.85, 0.55);
      dirLight.castShadow = true;
      scene.add(dirLight);

      var fillLight = new THREE.DirectionalLight(0xbae6fd, 0.55);
      fillLight.position.set(-0.55, 0.45, -0.35);
      scene.add(fillLight);

      // Mặt bàn gỗ phòng thí nghiệm bên dưới bộ thí nghiệm
      var labBenchGeo = new THREE.BoxGeometry(1.4, 0.04, 0.9);
      var labBenchMat = new THREE.MeshPhysicalMaterial({
        color: 0x0f172a,
        roughness: 0.65,
        metalness: 0.08
      });
      var labBench = new THREE.Mesh(labBenchGeo, labBenchMat);
      labBench.position.y = -0.0205;
      scene.add(labBench);

      var gridHelper = new THREE.GridHelper(1.2, 24, 0x334155, 0x1e293b);
      gridHelper.position.y = -0.0002;
      scene.add(gridHelper);

      // Dựng Bộ Mạch Điện Nối Tiếp 3D từ OL3D_EQUIPMENT_MODULE
      var kitRoot = window.OL3D_EQUIPMENT_MODULE.buildEquipmentMesh(THREE, manifest.asset);
      scene.add(kitRoot);

      // =========================================================================
      // TƯƠNG TÁC CHUỘT & CẢM ỨNG TRÊN KHÔNG GIAN 3D
      // =========================================================================
      var raycaster = new THREE.Raycaster();
      var mouse = new THREE.Vector2();
      var benchPlane = new THREE.Plane(new THREE.Vector3(0, 1, 0), -0.008);
      var planeIntersect = new THREE.Vector3();

      var isOrbiting = false;
      var isPanning = false;
      var draggingUnit = null;
      var draggingRheostat = false;
      var dragOffset = new THREE.Vector3();
      var pointerDownPos = { x: 0, y: 0 };
      var lastMousePos = { x: 0, y: 0 };
      var hoveredSocket = null;

      function setNormalizedMouse(evt) {
        var rect = renderer.domElement.getBoundingClientRect();
        var clientX = evt.touches ? evt.touches[0].clientX : evt.clientX;
        var clientY = evt.touches ? evt.touches[0].clientY : evt.clientY;
        mouse.x = ((clientX - rect.left) / rect.width) * 2 - 1;
        mouse.y = -((clientY - rect.top) / rect.height) * 2 + 1;
      }

      // Tìm cọc cắm hoặc thiết bị dưới con trỏ chuột
      function findHitTerminalOrUnit() {
        raycaster.setFromCamera(mouse, camera);
        var compGroup = kitRoot.userData.componentsGroup;
        var hits = raycaster.intersectObjects(compGroup.children, true);
        if (hits.length === 0) return { terminal: null, unit: null, isRheoWiper: false };

        var obj = hits[0].object;
        var terminalGroup = null;
        var unitGroup = null;
        var isRheoWiper = false;

        var curr = obj;
        while (curr && curr !== compGroup) {
          if (curr.userData && curr.userData.isTerminal) terminalGroup = curr;
          if (curr.name === 'plunger' && curr.parent && curr.parent.name === 'unit_rheostat') isRheoWiper = true;
          if (curr.parent === compGroup) unitGroup = curr;
          curr = curr.parent;
        }
        return { terminal: terminalGroup, unit: unitGroup, isRheoWiper: isRheoWiper };
      }

      renderer.domElement.addEventListener('mousedown', function(evt) {
        setNormalizedMouse(evt);
        pointerDownPos.x = evt.clientX;
        pointerDownPos.y = evt.clientY;
        lastMousePos.x = evt.clientX;
        lastMousePos.y = evt.clientY;

        if (evt.button === 2 || evt.shiftKey) {
          isPanning = true;
          return;
        }

        var hit = findHitTerminalOrUnit();

        // Nếu bấm trực tiếp vào Con chạy biến trở -> cho phép kéo trượt con chạy trên 3D!
        if (hit.isRheoWiper) {
          draggingRheostat = true;
          return;
        }

        // Nếu đang ở chế độ Kéo Di Chuyển Thiết Bị ('move')
        if (appState.interactionMode === 'move' && hit.unit) {
          draggingUnit = hit.unit;
          raycaster.setFromCamera(mouse, camera);
          if (raycaster.ray.intersectPlane(benchPlane, planeIntersect)) {
            dragOffset.copy(draggingUnit.position).sub(planeIntersect);
          }
          return;
        }

        isOrbiting = true;
      });

      window.addEventListener('mousemove', function(evt) {
        setNormalizedMouse(evt);
        var dx = evt.clientX - lastMousePos.x;
        var dy = evt.clientY - lastMousePos.y;
        lastMousePos.x = evt.clientX;
        lastMousePos.y = evt.clientY;

        // Kéo trượt con chạy biến trở trực tiếp trên 3D
        if (draggingRheostat) {
          raycaster.setFromCamera(mouse, camera);
          if (raycaster.ray.intersectPlane(benchPlane, planeIntersect)) {
            var rheoUnit = kitRoot.userData.units.rheostat;
            var localX = planeIntersect.x - rheoUnit.position.x;
            var frac = Math.max(0, Math.min(1, (localX + 0.056) / 0.112));
            appState.rheostatOhm = Math.round(frac * 40) / 2; // Bước 0.5 Ohm
            document.getElementById('slider-rheostat').value = appState.rheostatOhm;
            document.getElementById('lbl-rheostat-val').textContent = appState.rheostatOhm.toFixed(1) + ' Ω';
            solveElectricalCircuit();
            syncReadoutUI();
          }
          return;
        }

        // Kéo di chuyển thiết bị trên mặt bàn 3D
        if (draggingUnit) {
          raycaster.setFromCamera(mouse, camera);
          if (raycaster.ray.intersectPlane(benchPlane, planeIntersect)) {
            draggingUnit.position.x = Math.max(-0.24, Math.min(0.24, planeIntersect.x + dragOffset.x));
            draggingUnit.position.z = Math.max(-0.15, Math.min(0.15, planeIntersect.z + dragOffset.z));
            // Nếu di chuyển Giá đỡ pin thì 2 viên pin đi theo
            if (draggingUnit.name === 'unit_battery_holder') {
              var b1 = kitRoot.userData.units.battery_1;
              var b2 = kitRoot.userData.units.battery_2;
              if (appState.battery1Inserted) b1.position.set(draggingUnit.position.x, 0, draggingUnit.position.z + 0.022);
              if (appState.battery2Inserted) b2.position.set(draggingUnit.position.x, 0, draggingUnit.position.z - 0.022);
            }
            window.OL3D_EQUIPMENT_MODULE.rebuildWires3D(kitRoot, appState.wires);
          }
          return;
        }

        if (isOrbiting) {
          camSpherical.theta -= dx * 0.0075;
          camSpherical.phi -= dy * 0.0075;
          updateCameraFromSpherical();
          return;
        }

        if (isPanning) {
          camTarget.x -= dx * 0.0008;
          camTarget.z -= dy * 0.0008;
          updateCameraFromSpherical();
          return;
        }

        // Hiệu ứng phát sáng cọc cắm khi rê chuột qua
        var hit = findHitTerminalOrUnit();
        if (hoveredSocket && hoveredSocket !== hit.terminal) {
          if (hoveredSocket.userData.highlightMesh && hoveredSocket.userData.terminalId !== appState.selectedTerminalId) {
            hoveredSocket.userData.highlightMesh.material.opacity = 0.0;
          }
        }
        hoveredSocket = hit.terminal;
        if (hoveredSocket && hoveredSocket.userData.highlightMesh) {
          hoveredSocket.userData.highlightMesh.material.opacity = 0.85;
          renderer.domElement.style.cursor = 'pointer';
        } else if (hit.isRheoWiper || (hit.unit && (hit.unit.name === 'unit_switch' || hit.unit.name.indexOf('unit_battery_') === 0))) {
          renderer.domElement.style.cursor = 'pointer';
        } else {
          renderer.domElement.style.cursor = appState.interactionMode === 'move' ? 'grab' : 'default';
        }
      });

      window.addEventListener('mouseup', function(evt) {
        var moveDist = Math.hypot(evt.clientX - pointerDownPos.x, evt.clientY - pointerDownPos.y);
        isOrbiting = false;
        isPanning = false;
        draggingUnit = null;
        draggingRheostat = false;

        // Xử lý Click nhẹ (< 6px) trên thiết bị hoặc cọc nối
        if (moveDist < 6 && evt.button === 0 && evt.target === renderer.domElement) {
          setNormalizedMouse(evt);
          var hit = findHitTerminalOrUnit();

          // 1. Nếu click vào Cọc Cắm (Terminal) -> Chọn cọc 1, sau đó click cọc 2 để nối dây!
          if (hit.terminal) {
            handleTerminalClick3D(hit.terminal);
            return;
          }

          // 2. Nếu click vào Cầu Dao K -> Đóng / Ngắt khóa K
          if (hit.unit && hit.unit.name === 'unit_switch') {
            toggleKnifeSwitch();
            return;
          }

          // 3. Nếu click vào Viên Pin Con Ó #1 hoặc #2 -> Tháo viên pin ra khỏi giá đỡ hoặc lắp lại
          if (hit.unit && hit.unit.name === 'unit_battery_1') {
            appState.battery1Inserted = !appState.battery1Inserted;
            window.OL3D_EQUIPMENT_MODULE.playEquipmentSound('plug', 1);
            updateBatteryButtonUI();
            solveElectricalCircuit();
            syncReadoutUI();
            return;
          }
          if (hit.unit && hit.unit.name === 'unit_battery_2') {
            appState.battery2Inserted = !appState.battery2Inserted;
            window.OL3D_EQUIPMENT_MODULE.playEquipmentSound('plug', 1);
            updateBatteryButtonUI();
            solveElectricalCircuit();
            syncReadoutUI();
            return;
          }
        }
      });

      renderer.domElement.addEventListener('wheel', function(evt) {
        evt.preventDefault();
        camSpherical.radius += evt.deltaY * 0.0005;
        updateCameraFromSpherical();
      }, { passive: false });

      renderer.domElement.addEventListener('contextmenu', function(e) { e.preventDefault(); });

      // Xử lý click chọn 2 cọc trên 3D để cắm dây bắp chuối
      function handleTerminalClick3D(termGroup) {
        var tid = termGroup.userData.terminalId;
        var promptEl = document.getElementById('wiring-prompt');

        if (!appState.selectedTerminalId) {
          appState.selectedTerminalId = tid;
          termGroup.userData.highlightMesh.material.color.setHex(0xfde047);
          termGroup.userData.highlightMesh.material.opacity = 1.0;
          promptEl.textContent = 'Đã chọn [' + TERMINAL_META[tid].name + '] → Hãy click vào cọc thứ 2 để cắm dây!';
          promptEl.classList.remove('hidden');
          window.OL3D_EQUIPMENT_MODULE.playEquipmentSound('plug', 0.5);
        } else if (appState.selectedTerminalId === tid) {
          // Bỏ chọn nếu click lại chính nó
          termGroup.userData.highlightMesh.material.color.setHex(0x38bdf8);
          termGroup.userData.highlightMesh.material.opacity = 0.0;
          appState.selectedTerminalId = null;
          promptEl.classList.add('hidden');
        } else {
          // Nối dây giữa selectedTerminalId và tid
          var fromId = appState.selectedTerminalId;
          var prevObj = kitRoot.userData.componentsGroup.getObjectByName('terminal_' + fromId);
          if (prevObj && prevObj.userData.highlightMesh) {
            prevObj.userData.highlightMesh.material.color.setHex(0x38bdf8);
            prevObj.userData.highlightMesh.material.opacity = 0.0;
          }
          appState.selectedTerminalId = null;
          promptEl.classList.add('hidden');
          addBananaWire(fromId, tid, appState.newWireColor);
        }
      }

      window.addEventListener('keydown', function(evt) {
        if (evt.key === 'Escape' && appState.selectedTerminalId) {
          var prevObj = kitRoot.userData.componentsGroup.getObjectByName('terminal_' + appState.selectedTerminalId);
          if (prevObj && prevObj.userData.highlightMesh) {
            prevObj.userData.highlightMesh.material.color.setHex(0x38bdf8);
            prevObj.userData.highlightMesh.material.opacity = 0.0;
          }
          appState.selectedTerminalId = null;
          document.getElementById('wiring-prompt').classList.add('hidden');
        }
      });

      // =========================================================================
      // QUẢN LÝ DÂY NỐI, LINH KIỆN THÁO RỜI & ĐỒNG BỘ GIAO DIỆN
      // =========================================================================
      function addBananaWire(fromId, toId, colorHex) {
        if (!fromId || !toId || fromId === toId) return;
        // Kiểm tra xem đã có dây nối đúng 2 cọc này chưa
        for (var i = 0; i < appState.wires.length; i++) {
          var w = appState.wires[i];
          if ((w.from === fromId && w.to === toId) || (w.from === toId && w.to === fromId)) {
            return;
          }
        }
        var newId = 'w_' + Date.now() + '_' + Math.floor(Math.random() * 100);
        appState.wires.push({ id: newId, from: fromId, to: toId, color: colorHex });
        window.OL3D_EQUIPMENT_MODULE.playEquipmentSound('plug', 1);
        window.OL3D_EQUIPMENT_MODULE.rebuildWires3D(kitRoot, appState.wires);
        solveElectricalCircuit();
        renderWireListUI();
        syncReadoutUI();
      }

      function removeBananaWire(wireId) {
        appState.wires = appState.wires.filter(function(w) { return w.id !== wireId; });
        window.OL3D_EQUIPMENT_MODULE.playEquipmentSound('plug', 0.2);
        window.OL3D_EQUIPMENT_MODULE.rebuildWires3D(kitRoot, appState.wires);
        solveElectricalCircuit();
        renderWireListUI();
        syncReadoutUI();
      }

      function toggleKnifeSwitch() {
        appState.switchClosed = !appState.switchClosed;
        window.OL3D_EQUIPMENT_MODULE.playEquipmentSound('switch', appState.switchClosed ? 1 : 0);
        var btn = document.getElementById('btn-toggle-switch');
        var lbl = document.getElementById('lbl-switch-state');
        if (appState.switchClosed) {
          btn.className = 'p-2.5 rounded-xl bg-emerald-500/20 border border-emerald-500/40 text-emerald-300 hover:bg-emerald-500/30 transition text-left';
          lbl.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> ĐANG ĐÓNG (ON)';
        } else {
          btn.className = 'p-2.5 rounded-xl bg-rose-500/20 border border-rose-500/40 text-rose-300 hover:bg-rose-500/30 transition text-left';
          lbl.innerHTML = '<span class="w-2 h-2 rounded-full bg-rose-400"></span> ĐANG NGẮT (OFF)';
        }
        solveElectricalCircuit();
        syncReadoutUI();
      }

      function updateBatteryButtonUI() {
        var lbl = document.getElementById('lbl-battery-state');
        var count = (appState.battery1Inserted ? 1 : 0) + (appState.battery2Inserted ? 1 : 0);
        if (count === 2) lbl.textContent = 'Đã lắp 2 Pin (' + appState.ratedEmfV.toFixed(1) + 'V)';
        else if (count === 1) lbl.textContent = 'Lắp 1 Pin (' + (appState.ratedEmfV * 0.5).toFixed(1) + 'V)';
        else lbl.textContent = 'Đã tháo 2 Pin (0V)';
        renderComponentListUI();
