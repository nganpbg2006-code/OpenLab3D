      // Vẽ mặt chia độ Ampe kế hoặc Vôn kế đúng như ảnh chụp thực tế
      function drawMeterDialCanvas(canvas, type) {
        var ctx = canvas.getContext('2d');
        var w = canvas.width;
        var h = canvas.height;
        ctx.clearRect(0, 0, w, h);

        // Nền trắng ngà của mặt đồng hồ
        ctx.fillStyle = '#f8fafc';
        ctx.fillRect(0, 0, w, h);

        // Viền mảnh kỹ thuật
        ctx.strokeStyle = '#cbd5e1';
        ctx.lineWidth = 4;
        ctx.strokeRect(4, 4, w - 8, h - 8);

        var cx = w / 2;
        var cy = h * 0.86;
        var rOuter = w * 0.40;
        var rMirror = w * 0.31;
        var rInner = w * 0.25;

        // Rãnh gương chống thị sai (vệt bạc hình cung như ảnh thật)
        ctx.save();
        ctx.beginPath();
        ctx.arc(cx, cy, rMirror + 10, -Math.PI * 0.78, -Math.PI * 0.22);
        ctx.arc(cx, cy, rMirror - 10, -Math.PI * 0.22, -Math.PI * 0.78, true);
        ctx.closePath();
        var grad = ctx.createLinearGradient(cx - 120, cy - 120, cx + 120, cy - 80);
        grad.addColorStop(0, '#cbd5e1');
        grad.addColorStop(0.5, '#f1f5f9');
        grad.addColorStop(1, '#94a3b8');
        ctx.fillStyle = grad;
        ctx.fill();
        ctx.strokeStyle = '#64748b';
        ctx.lineWidth = 1.5;
        ctx.stroke();
        ctx.restore();

        // Cung chia độ chính
        var startAng = -Math.PI * 0.76; // -136.8 deg
        var endAng = -Math.PI * 0.24;   // -43.2 deg
        var totalSpan = endAng - startAng;

        ctx.beginPath();
        ctx.arc(cx, cy, rOuter, startAng, endAng);
        ctx.strokeStyle = '#0f172a';
        ctx.lineWidth = 2.5;
        ctx.stroke();

        ctx.beginPath();
        ctx.arc(cx, cy, rInner, startAng, endAng);
        ctx.strokeStyle = '#334155';
        ctx.lineWidth = 1.8;
        ctx.stroke();

        // 30 vạch chia nhỏ, 6 vạch chia lớn
        var ticks = 30;
        for (var i = 0; i <= ticks; i++) {
          var frac = i / ticks;
          var ang = startAng + frac * totalSpan;
          var cos = Math.cos(ang);
          var sin = Math.sin(ang);
          var isMajor = (i % 5 === 0);
          var isMid = (i % 5 === 2 || i % 5 === 3);

          var lenOut = isMajor ? 18 : (i % 5 === 0 ? 14 : 9);
          ctx.beginPath();
          ctx.moveTo(cx + cos * rOuter, cy + sin * rOuter);
          ctx.lineTo(cx + cos * (rOuter + lenOut), cy + sin * (rOuter + lenOut));
          ctx.strokeStyle = '#0f172a';
          ctx.lineWidth = isMajor ? 3.0 : 1.5;
          ctx.stroke();

          var lenIn = isMajor ? 14 : 7;
          ctx.beginPath();
          ctx.moveTo(cx + cos * rInner, cy + sin * rInner);
          ctx.lineTo(cx + cos * (rInner - lenIn), cy + sin * (rInner - lenIn));
          ctx.strokeStyle = '#334155';
          ctx.lineWidth = isMajor ? 2.4 : 1.2;
          ctx.stroke();

          if (isMajor) {
            var stepIdx = i / 5; // 0..6
            var topLabel = type === 'A' ? (stepIdx * 0.5).toFixed(stepIdx % 2 === 0 ? 0 : 1) : (stepIdx * 2).toString();
            var botLabel = type === 'A' ? (stepIdx * 0.1).toFixed(1) : (stepIdx * 1).toString();
            if (stepIdx === 0) { topLabel = '0'; botLabel = '0'; }

            ctx.save();
            ctx.translate(cx + cos * (rOuter + 32), cy + sin * (rOuter + 32));
            ctx.rotate(ang + Math.PI / 2);
            ctx.fillStyle = '#0f172a';
            ctx.font = 'bold 20px Inter, sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText(topLabel, 0, 0);
            ctx.restore();

            ctx.save();
            ctx.translate(cx + cos * (rInner - 26), cy + sin * (rInner - 26));
            ctx.rotate(ang + Math.PI / 2);
            ctx.fillStyle = '#334155';
            ctx.font = 'bold 16px Inter, sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText(botLabel, 0, 4);
            ctx.restore();
          }
        }

        // Chữ A hoặc V lớn ở chính giữa kèm gạch ngang DC bên dưới
        ctx.fillStyle = '#0f172a';
        ctx.font = 'bold 44px Inter, sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(type, cx, cy - rInner * 0.42);
        ctx.fillRect(cx - 18, cy - rInner * 0.34, 36, 4);

        // Ký hiệu cấp chính xác 2.5 góc phải dưới (như ảnh chụp thật)
        ctx.fillStyle = '#475569';
        ctx.font = 'bold 15px Inter, sans-serif';
        ctx.textAlign = 'right';
        ctx.fillText('Cấp 2.5  ⊥', w - 26, h - 38);
        ctx.textAlign = 'left';
        ctx.fillText('DC NO.2026', 26, h - 38);

        // Vòm bán nguyệt xám che trục kim ở đáy mặt đồng hồ
        ctx.beginPath();
        ctx.arc(cx, cy, 42, Math.PI, 0);
        ctx.fillStyle = '#64748b';
        ctx.fill();
        ctx.strokeStyle = '#334155';
        ctx.lineWidth = 2;
        ctx.stroke();
      }

      // Vẽ nhãn Pin Đại Con Ó (PINACO R20 1.5V) đúng thiết kế vàng-đen đặc trưng
      function createConOBatteryTexture() {
        var canvas = document.createElement('canvas');
        canvas.width = 512;
        canvas.height = 256;
        var ctx = canvas.getContext('2d');

        // Nền vàng đặc trưng Pin Con Ó
        ctx.fillStyle = '#facc15';
        ctx.fillRect(0, 0, 512, 256);

        // Dải đen dọc thân pin
        ctx.fillStyle = '#0f172a';
        ctx.fillRect(140, 0, 120, 256);
        ctx.fillRect(0, 224, 512, 32);
        ctx.fillRect(0, 0, 512, 14);

        // Dòng chữ CON Ó lớn
        ctx.save();
        ctx.translate(80, 128);
        ctx.rotate(-Math.PI / 2);
        ctx.fillStyle = '#0f172a';
        ctx.font = '900 44px Inter, sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('CON Ó', 0, 0);
        ctx.font = 'bold 14px Inter, sans-serif';
        ctx.fillText('SINCE 1954', 0, 20);
        ctx.restore();

        // Thông số kỹ thuật trên dải đen
        ctx.save();
        ctx.translate(200, 128);
        ctx.rotate(-Math.PI / 2);
        ctx.fillStyle = '#f8fafc';
        ctx.font = 'bold 16px Inter, sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('R20 - UM1 - D SIZE - 1.5V', 0, -10);
        ctx.fillStyle = '#fde047';
        ctx.font = 'bold 15px Inter, sans-serif';
        ctx.fillText('SẢN PHẨM CỦA PINACO', 0, 16);
        ctx.restore();

        // Dấu cộng (+) và trừ (-)
        ctx.fillStyle = '#dc2626';
        ctx.beginPath();
        ctx.arc(340, 42, 16, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 26px Inter, sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('+', 340, 51);

        ctx.fillStyle = '#0f172a';
        ctx.beginPath();
        ctx.arc(340, 200, 14, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#facc15';
        ctx.fillText('-', 340, 208);

        return new THREE.CanvasTexture(canvas);
      }

