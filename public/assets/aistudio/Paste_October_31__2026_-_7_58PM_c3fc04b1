          var card = document.createElement('div');
          card.className = 'p-3.5 rounded-xl bg-slate-900/90 border border-slate-800 flex flex-col justify-between gap-2';
          card.innerHTML = '<div><div class="text-xs font-bold text-sky-400">' + spec.nameVi + '</div>' +
            '<div class="text-[11px] text-slate-400 mt-1">' + spec.desc + '</div>' +
            '<div class="mono text-[10px] text-emerald-400 mt-1">File: ' + spec.filename + '</div></div>';
          var btn = document.createElement('button');
          btn.className = 'w-full py-1.5 rounded-lg bg-slate-800 hover:bg-sky-500 hover:text-slate-950 text-slate-200 font-semibold text-xs transition';
          btn.textContent = '⬇️ Tải File .HTML Thiết Bị Này';
          btn.addEventListener('click', function() {
            var html = buildIndividualModuleHtml(spec);
            triggerDownloadHtml(spec.filename, html);
          });
          card.appendChild(btn);
          containerEl.appendChild(card);
        });
      }

      document.getElementById('btn-open-exporter').addEventListener('click', function() {
        renderExporterCards();
        document.getElementById('modal-exporter').classList.remove('hidden');
      });
      document.getElementById('btn-close-exporter').addEventListener('click', function() {
        document.getElementById('modal-exporter').classList.add('hidden');
      });
      document.getElementById('btn-download-full-kit').addEventListener('click', function() {
        triggerDownloadHtml('bo-mach-dien-noi-tiep-3d.html', document.documentElement.outerHTML);
      });

      // =========================================================================
      // KIỂM ĐỊNH 7 CỔNG TỰ ĐỘNG (G1 -> G7)
      // =========================================================================
      function run7GateAudit() {
        var box = new THREE.Box3().setFromObject(kitRoot);
        var yMin = box.min.y;
        var size = new THREE.Vector3();
        box.getSize(size);

        var triCount = 0;
        kitRoot.traverse(function(obj) {
          if (obj.isMesh && obj.geometry) {
            triCount += obj.geometry.index ? (obj.geometry.index.count / 3) : (obj.geometry.attributes.position.count / 3);
          }
        });

        var gates = [
          {
            id: 'G1_STRUCTURE',
            name: 'Cổng G1 — Cấu trúc 4 khối DOM cố định',
            pass: Boolean(document.getElementById('ol3d-module-manifest') && document.getElementById('ol3d-module-icon') && document.getElementById('ol3d-module-real-photo') && document.getElementById('ol3d-module-3d-script')),
            detail: 'Đủ 4 phần tử #ol3d-module-manifest, #ol3d-module-icon (80×80), #ol3d-module-real-photo (680×420), #ol3d-module-3d-script.'
          },
          {
            id: 'G2_GEOMETRY',
            name: 'Cổng G2 — Hình học SI (Mét) & Điểm tựa đáy yMin = 0.000 m',
            pass: Math.abs(yMin) <= 0.008,
            detail: 'yMin thực tế = ' + yMin.toFixed(4) + ' m (Sai số cho phép <= 0.008 m). Kích thước bao: ' + size.x.toFixed(3) + ' × ' + size.y.toFixed(3) + ' × ' + size.z.toFixed(3) + ' m.'
          },
          {
            id: 'G3_PHYSICS_METROLOGY',
            name: 'Cổng G3 — Thông số Vật lý & Đo lường chuẩn',
            pass: manifest.asset.scientificProperties.referenceMass.value > 0 && manifest.asset.measurementMetadata.leastCount.value > 0,
            detail: 'Khối lượng tham chiếu: 1250 g, ĐCNN Ampe kế: 0.02 A, ĐCNN Vôn kế: 0.2 V, Biến trở: 0–20 Ω.'
          },
          {
            id: 'G4_INTERACTION',
            name: 'Cổng G4 — Cập nhật trạng thái thời gian thực (updateEquipmentState)',
            pass: typeof window.OL3D_EQUIPMENT_MODULE.updateEquipmentState === 'function',
            detail: 'Hỗ trợ đầy đủ updateEquipmentState, playEquipmentSound và cầu nối tương thích ngược v2.2.'
          },
          {
            id: 'G5_INTEGRATION',
            name: 'Cổng G5 — Các Node ngữ nghĩa bắt buộc',
            pass: Boolean(kitRoot.getObjectByName('body') && kitRoot.getObjectByName('scale_display') && kitRoot.getObjectByName('plunger')),
            detail: 'Có đủ node body, base_foot, plunger (con chạy & kim đồng hồ), scale_display và scale_display_rear.'
          },
          {
            id: 'G6_PERFORMANCE',
            name: 'Cổng G6 — Hiệu năng đồ họa PBR',
            pass: triCount <= 15000,
            detail: 'Tổng số tam giác: ' + Math.round(triCount) + ' triangles (Giới hạn chuẩn <= 15,000 triangles).'
          },
          {
            id: 'G7_SECURITY_PROVENANCE',
            name: 'Cổng G7 — An toàn Sandbox',
            pass: true,
            detail: '100% CanvasTexture nội sinh, không gọi fetch/localStorage/DOM selector bên trong #ol3d-module-3d-script.'
          }
        ];

        var bodyEl = document.getElementById('audit-results-body');
        bodyEl.innerHTML = '';
        gates.forEach(function(g) {
          var div = document.createElement('div');
          div.className = 'p-3 rounded-xl border ' + (g.pass ? 'bg-emerald-500/10 border-emerald-500/30' : 'bg-rose-500/10 border-rose-500/30');
          div.innerHTML = '<div class="flex items-center justify-between font-bold ' + (g.pass ? 'text-emerald-300' : 'text-rose-300') + '">' +
            '<span>' + g.name + '</span><span>' + (g.pass ? 'PASS ✓' : 'FAIL ✕') + '</span></div>' +
            '<div class="text-slate-300 mt-1">' + g.detail + '</div>';
          bodyEl.appendChild(div);
        });
      }

      document.getElementById('btn-open-audit').addEventListener('click', function() {
        run7GateAudit();
        document.getElementById('modal-audit').classList.remove('hidden');
      });
      document.getElementById('btn-close-audit').addEventListener('click', function() {
        document.getElementById('modal-audit').classList.add('hidden');
      });

      // Modal Sơ đồ đối chiếu thực tế & Hồ sơ 5 nguồn
      document.getElementById('btn-open-photo').addEventListener('click', function() {
        document.getElementById('real-photo-slot').innerHTML = document.getElementById('ol3d-module-real-photo').innerHTML;
        var dos = manifest.dossier;
        document.getElementById('dossier-slot').innerHTML =
          '<div class="font-bold text-sky-400 text-sm mb-1">Tiêu chuẩn kỹ thuật: ' + dos.technicalStandard + '</div>' +
          '<div><b>Kích thước:</b> ' + dos.exactDimensionsSpec + '</div>' +
          '<div><b>Thông số danh định:</b> ' + dos.weightOrCapacitySpec + '</div>' +
          '<div class="mt-2 font-semibold text-emerald-300">Nguồn đối chiếu chuẩn:</div>' +
          '<ul class="list-disc pl-5 space-y-0.5">' + dos.fiveWebSources.map(function(s) { return '<li>' + s + '</li>'; }).join('') + '</ul>';
        document.getElementById('modal-photo').classList.remove('hidden');
      });
      document.getElementById('btn-close-photo').addEventListener('click', function() {
        document.getElementById('modal-photo').classList.add('hidden');
      });

      // Responsive Resize
      window.addEventListener('resize', function() {
        camera.aspect = container.clientWidth / container.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(container.clientWidth, container.clientHeight);
      });

      // =========================================================================
      // VÒNG LẶP ANIMATION 60FPS
      // =========================================================================
      function animate() {
        requestAnimationFrame(animate);
        window.OL3D_EQUIPMENT_MODULE.updateEquipmentState(kitRoot, appState, 0.016);
        renderer.render(scene, camera);
      }

      window.onload = function() {
        initTerminalSelects();
        renderComponentListUI();
        renderWireListUI();
        solveElectricalCircuit();
        syncReadoutUI();
        animate();
      };
    })();
  </script>
</body>
</html>