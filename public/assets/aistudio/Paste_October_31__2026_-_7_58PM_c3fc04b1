  <!-- ============================================================================
       KHỐI 4: RUNTIME 3D SCRIPT CHUẨN SANDBOX OL3D-HTML-MODULE-v2.4 (HARD CRITERION #4)
       TUYỆT ĐỐI KHÔNG DÙNG DOM SELECTOR / FETCH BÊN TRONG KHỐI NÀY
       ============================================================================ -->
  <script id="ol3d-module-3d-script">
    (function() {
      // Hàm tạo hình chữ nhật bo góc ExtrudeGeometry có đáy tại y = 0
      function createRoundedBoxGeometry(THREE, w, h, d, radius, bevel) {
        var r = Math.min(radius || 0.004, w * 0.4, d * 0.4);
        var b = Math.min(bevel || 0.0015, r * 0.5, h * 0.25);
        var hw = w / 2 - b;
        var hd = d / 2 - b;
        var shape = new THREE.Shape();
        shape.moveTo(-hw + r, -hd);
        shape.lineTo(hw - r, -hd);
        shape.quadraticCurveTo(hw, -hd, hw, -hd + r);
        shape.lineTo(hw, hd - r);
        shape.quadraticCurveTo(hw, hd, hw - r, hd);
        shape.lineTo(-hw + r, hd);
        shape.quadraticCurveTo(-hw, hd, -hw, hd - r);
        shape.lineTo(-hw, -hd + r);
        shape.quadraticCurveTo(-hw, -hd, -hw + r, -hd);

        var extrudeSettings = {
          depth: Math.max(0.001, h - 2 * b),
          bevelEnabled: true,
          bevelSegments: 4,
          steps: 1,
          bevelSize: b,
          bevelThickness: b
        };
        var geo = new THREE.ExtrudeGeometry(shape, extrudeSettings);
        geo.rotateX(-Math.PI / 2);
        geo.computeBoundingBox();
        var minY = geo.boundingBox.min.y;
        geo.translate(0, -minY, 0);
        geo.computeVertexNormals();
        return geo;
      }

      // Hàm tạo Cọc Cắm Bắp Chuối (Banana Socket) có lỗ kim loại ở giữa
      function createBananaSocket(THREE, id, label, colorHex, x, y, z, tiltX) {
        var sockGroup = new THREE.Group();
        sockGroup.name = 'terminal_' + id;
        sockGroup.position.set(x, y, z);
        if (tiltX) sockGroup.rotation.x = tiltX;

