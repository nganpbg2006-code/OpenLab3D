      // 5. Dựng Biến Trở Con Chạy 20Ω đúng ảnh `bien-tro-con-chay.jpg`
      function buildRheostatUnit(THREE) {
        var unit = new THREE.Group();
        unit.name = 'unit_rheostat';

        // Đế nhựa/gỗ phíp màu nâu đỏ có in sơ đồ U_VÀO - U_RA
        var baseMat = new THREE.MeshPhysicalMaterial({
          color: 0x7f1d1d,
          roughness: 0.28,
          metalness: 0.08,
          clearcoat: 0.5
        });
        var baseMesh = new THREE.Mesh(createRoundedBoxGeometry(THREE, 0.176, 0.014, 0.068, 0.004, 0.0015), baseMat);
        baseMesh.name = 'body';
        unit.add(baseMesh);

        // Sơ đồ màu trắng in trên mặt đế phía trước
        var diagCanvas = document.createElement('canvas');
        diagCanvas.width = 512;
        diagCanvas.height = 128;
        var dctx = diagCanvas.getContext('2d');
        dctx.fillStyle = '#7f1d1d';
        dctx.fillRect(0, 0, 512, 128);
        dctx.strokeStyle = '#f8fafc';
        dctx.fillStyle = '#f8fafc';
        dctx.lineWidth = 4;
        // Vẽ ký hiệu điện trở răng cưa và mũi tên con chạy như ảnh thật
        dctx.beginPath();
        dctx.moveTo(70, 88);
        dctx.lineTo(180, 88);
        dctx.moveTo(290, 88);
        dctx.lineTo(430, 88);
        // Zigzag ở giữa
        dctx.moveTo(190, 42);
        var zx = 190;
        for (var k = 0; k < 6; k++) {
          dctx.lineTo(zx + 10, k % 2 === 0 ? 22 : 58);
          zx += 10;
        }
        dctx.stroke();
        dctx.font = 'bold 22px Inter, sans-serif';
        dctx.fillText('U VÀO', 110, 110);
        dctx.fillText('U RA', 310, 110);

        var diagPlane = new THREE.Mesh(
          new THREE.PlaneGeometry(0.162, 0.028),
          new THREE.MeshBasicMaterial({ map: new THREE.CanvasTexture(diagCanvas), polygonOffset: true, polygonOffsetFactor: -2 })
        );
        diagPlane.rotation.x = -Math.PI / 2;
        diagPlane.position.set(0, 0.0142, 0.016);
        unit.add(diagPlane);

        // 2 chân giá đỡ màu đen ở 2 đầu
